datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Incident {
  id             String   @id @default(uuid())
  serviceName    String
  status         String   @default("DETECTED") // DETECTED -> INVESTIGATING -> PENDING_APPROVAL -> RESOLVED
  rootCause      String?
  confidence     Float?
  recovery       String?
  createdAt      DateTime @default(now())
}
